# Variables de entorno de Constructor RAG
# Copia este archivo a `.env` y rellena con valores reales en el servidor.

# --- Almacenamiento ---
# Bases SQLite (se crean automáticamente al arrancar)
LOG_DB_PATH=logs.db
AGENTES_DB_PATH=agentes.db

# ChromaDB (vector store) y carpeta temporal de uploads
CHROMA_PATH=chroma
TEMP_FOLDER=./_temp

# --- Modelos ---
# Endpoint de Ollama (típicamente local en el server)
OLLAMA_URL=http://localhost:11434

# false = los modelos de Ollama nacen DESACTIVADOS en el registro de modelos.
# Para despliegues sin un Ollama alcanzable (p.ej. el droplet compartido de DO),
# donde correr un LLM local no es viable. Sólo afecta el seed de una BD nueva;
# nunca pisa lo que ya hayas editado desde el admin. Default: true.
OLLAMA_HABILITADO=true

# Modelo de embedding por defecto (fallback cuando un contexto no tiene metadata)
TEXT_EMBEDDING_MODEL=

# API key de OpenAI — solo si se van a usar modelos OpenAI
# (gpt-4o, gpt-4o-mini, text-embedding-3-*, etc.)
OPENAI_API_KEY=

# --- HTTP ---
# Lista separada por comas de orígenes permitidos para CORS.
# "*" para abierto. En staging/prod usar allowlist explícita con los frontends
# que consumen esta API:
#   - buzzword-agentes-ui (admin):     localhost:5173 (dev), 172.10.30.15:4175 (staging), 172.10.30.16:4175 (prod)
#   - host-asistentes (embeds):        localhost:5174 (dev), 172.10.30.15:4176 (staging), 172.10.30.16:4176 (prod)
# Ejemplo prod:
#   CORS_ALLOWED_ORIGINS=http://172.10.30.16:4175,http://172.10.30.16:4176
CORS_ALLOWED_ORIGINS=*

# --- Admin ---
# Token compartido entre el .env del server y el bookmark del admin.
# Endpoints protegidos esperan: Authorization: Bearer <ADMIN_PASSWORD>.
# Hoy: POST/PUT/DELETE de /proyectos y DELETE /borrarModelo. El resto sigue público.
# OJO: el password viaja en plano por HTTP — solo aceptable en LAN interna o
# detrás de TLS. No expongas el server directo a internet sin HTTPS.
ADMIN_PASSWORD=
